{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "je-mange-africain",
  "account_id": "82164eca9557f63e18984230deac12bc",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare-worker.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "je-mange-africain.com",
      "custom_domain": true
    },
    {
      "pattern": "www.je-mange-africain.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.je-mange-africain.com",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ecda2d6ebe7e44babfe8e29ab4fabecc"
    }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "82164eca9557f63e18984230deac12bc",
    "CLOUDFLARE_DEPLOYMENT_TARGET": "workers",
    "CLOUDFLARE_DOMAIN_STATUS": "attached",
    "NEXT_PUBLIC_SITE_URL": "https://je-mange-africain.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://ahigidhuhqcmxzjxetnw.supabase.co",
    "PAYMENTS_ENABLED": "false",
    "SUPABASE_URL": "https://ahigidhuhqcmxzjxetnw.supabase.co"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
