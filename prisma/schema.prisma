// Prisma schema — « Je mange Africain »
// SQLite provider (project constraint). Enums stored as String.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Users & RBAC
 */
/**
 * -----------------------------------------------------------------
 */

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String?
  role              String             @default("customer") // customer | super_admin | direction | catalog_manager | recipe_manager | purchase_manager | warehouse_manager | picker | logistics | support | marketing | accounting
  firstName         String?
  lastName          String?
  phone             String?            @unique
  isActive          Boolean            @default(true)
  twoFactor         Boolean            @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customer          Customer?
  auditLogs         AuditLog[]
  legalConsents     LegalConsent[]
  pushSubscriptions PushSubscription[]
}

model LegalConsent {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion      String
  privacyVersion    String
  termsAcceptedAt   DateTime
  privacyAcceptedAt DateTime
  source            String   @default("customer_registration")
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
}

model Permission {
  id        String   @id @default(cuid())
  role      String
  module    String // catalog | recipes | stock | orders | payments | refunds | marketing | users | settings
  actions   String // JSON array: ["read","create","update","delete"]
  createdAt DateTime @default(now())

  @@unique([role, module])
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Customers
 */
/**
 * -----------------------------------------------------------------
 */

model Customer {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyPoints Int             @default(0)
  walletCredit  Decimal         @default(0)
  preferredLang String          @default("fr")
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  addresses     Address[]
  orders        Order[]
  tickets       SupportTicket[]
  favorites     Favorite[]
  savedRecipes  SavedRecipe[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String
  firstName  String
  lastName   String
  street     String
  postalCode String
  city       String
  country    String
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model SavedRecipe {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, recipeId])
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Catalog
 */
/**
 * -----------------------------------------------------------------
 */

model Category {
  id            String     @id @default(cuid())
  slug          String     @unique
  nameFr        String
  nameEn        String
  descriptionFr String?
  descriptionEn String?
  icon          String? // emoji or icon name
  color         String? // hex
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  products      Product[]
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameFr    String
  nameEn    String
  country   String?
  logo      String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  country        String
  contact        String?
  email          String?
  phone          String?
  rating         Int             @default(3) // 1..5
  createdAt      DateTime        @default(now())
  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model Product {
  id                     String                 @id @default(cuid())
  sku                    String                 @unique
  barcode                String?
  traditionalName        String
  categoryId             String
  category               Category               @relation(fields: [categoryId], references: [id])
  brandId                String?
  brand                  Brand?                 @relation(fields: [brandId], references: [id])
  supplierId             String?
  supplier               Supplier?              @relation(fields: [supplierId], references: [id])
  country                String                 @default("Côte d'Ivoire")
  thermalClass           String                 @default("AMBIANT") // AMBIANT | REFRIGERATED | FROZEN
  storageType            String                 @default("SEC") // SEC | FRAIS | REFRIGERE | SURGELE | FUME | SECHE | CONSERVE
  storageTempC           String? // e.g. "-18°C"
  netWeightGrams         Int                    @default(0)
  volumeMl               Int                    @default(0)
  unit                   String                 @default("piece") // piece | kg | g | L | ml
  packaging              String // "Boîte 400 g", "Sac 1 kg"
  costPrice              Decimal?
  profitMargin           Decimal?
  price                  Decimal
  promoPrice             Decimal?
  pricePerKg             Decimal?
  isWholesale            Boolean                @default(false)
  wholesalePackLabel     String?
  wholesaleUnitsPerPack  Int                    @default(1)
  wholesaleMinPacks      Int                    @default(1)
  wholesalePrice         Decimal?
  wholesaleTier2MinPacks Int?
  wholesaleTier2Price    Decimal?
  wholesaleTier3MinPacks Int?
  wholesaleTier3Price    Decimal?
  stockQty               Int                    @default(0)
  reservedQty            Int                    @default(0)
  alertThreshold         Int                    @default(5)
  imageColor             String                 @default("#D65A32")
  imageEmoji             String                 @default("🍲")
  imageUrl               String?
  galleryUrls            String? // JSON array of public image URLs
  isBestseller           Boolean                @default(false)
  isNew                  Boolean                @default(false)
  isRecommended          Boolean                @default(false)
  isOnSale               Boolean                @default(false)
  status                 String                 @default("published") // draft | published | archived
  nutrition              String? // JSON string
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  translations           ProductTranslation[]
  aliases                ProductAlias[]
  variants               ProductVariant[]
  batches                InventoryBatch[]
  recipeIngredients      RecipeIngredient[]
  favorites              Favorite[]
  orderAllocations       OrderBatchAllocation[]

  @@index([status, isWholesale])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String // fr | en
  name        String
  description String
  preparation String?
  storage     String?
  ingredients String?
  allergens   String?
  validated   Boolean @default(true)

  @@unique([productId, locale])
}

model ProductAlias {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  alias     String
  locale    String? // null = all locales

  @@unique([productId, alias])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String // "400 g", "1 kg", "Lot de 2"
  weightGrams Int      @default(0)
  volumeMl    Int      @default(0)
  price       Decimal
  pricePerKg  Decimal?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Recipes
 */
/**
 * -----------------------------------------------------------------
 */

model Recipe {
  id            String              @id @default(cuid())
  slug          String              @unique
  country       String
  category      String // sauces | mains | sides | grill | drinks | desserts | porridge | country | family | events
  difficulty    String              @default("medium") // easy | medium | hard
  timeMinutes   Int                 @default(45)
  baseServings  Int                 @default(4)
  imageColor    String              @default("#8A3042")
  imageEmoji    String              @default("🍽️")
  imageUrl      String?
  galleryUrls   String? // JSON array of public image URLs
  isPopular     Boolean             @default(false)
  isNew         Boolean             @default(false)
  isRecommended Boolean             @default(false)
  status        String              @default("published") // draft | published | archived
  videoUrl      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  translations  RecipeTranslation[]
  ingredients   RecipeIngredient[]
  savedBy       SavedRecipe[]
}

model RecipeTranslation {
  id          String @id @default(cuid())
  recipeId    String
  recipe      Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String
  steps       String // JSON array of steps

  @@unique([recipeId, locale])
}

model RecipeIngredient {
  id              String  @id @default(cuid())
  recipeId        String
  recipe          Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  variantId       String?
  quantityPerBase Float // quantity needed for baseServings, in `unit`
  unit            String // g | kg | ml | L | piece | tbsp | tsp
  role            String  @default("base") // protein | base | aromatic | spice | fat | side | optional
  optional        Boolean @default(false)
  alternatives    String? // JSON array of productIds
  note            String?
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Warehouses & stock
 */
/**
 * -----------------------------------------------------------------
 */

model Warehouse {
  id                String              @id @default(cuid())
  name              String
  city              String
  address           String?
  ambientZones      Int                 @default(1)
  refrigeratedZones Int                 @default(1)
  frozenZones       Int                 @default(1)
  createdAt         DateTime            @default(now())
  locations         WarehouseLocation[]
  batches           InventoryBatch[]
}

model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String // e.g. A-03-12
  zone        String // AMBIANT | REFRIGERATED | FROZEN
  aisle       String?
  shelf       String?
}

model InventoryBatch {
  id               String                 @id @default(cuid())
  productId        String
  product          Product                @relation(fields: [productId], references: [id])
  warehouseId      String
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id])
  locationId       String?
  lotNumber        String
  quantity         Int                    @default(0)
  reserved         Int                    @default(0)
  expiryDate       DateTime?
  receiptDate      DateTime               @default(now())
  costPrice        Decimal                @default(0)
  status           String                 @default("active") // active | blocked | recalled | expired
  createdAt        DateTime               @default(now())
  movements        StockMovement[]
  orderAllocations OrderBatchAllocation[]
}

model OrderBatchAllocation {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  batchId   String
  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  quantity  Int
  unitCost  Decimal
  createdAt DateTime       @default(now())

  @@index([orderId, productId])
  @@index([batchId])
}

model StockMovement {
  id          String          @id @default(cuid())
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  productId   String
  warehouseId String
  type        String // receipt | reservation | release | pick | transfer | loss | damage | recall | adjustment
  quantity    Int // signed
  reason      String?
  userId      String?
  beforeQty   Int?
  afterQty    Int?
  createdAt   DateTime        @default(now())
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Purchasing
 */
/**
 * -----------------------------------------------------------------
 */

model PurchaseOrder {
  id            String              @id @default(cuid())
  number        String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        String              @default("draft") // draft | sent | in_transit | received | partial | cancelled
  currency      String              @default("EUR")
  transportCost Decimal             @default(0)
  insurance     Decimal             @default(0)
  customsCost   Decimal             @default(0)
  taxCost       Decimal             @default(0)
  departureAt   DateTime?
  expectedAt    DateTime?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  items         PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  quantity        Int
  unitCost        Decimal
  receivedQty     Int           @default(0)
  refusedQty      Int           @default(0)
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Orders & payments
 */
/**
 * -----------------------------------------------------------------
 */

model Order {
  id                 String                 @id @default(cuid())
  number             String                 @unique
  customerId         String?
  customer           Customer?              @relation(fields: [customerId], references: [id])
  status             String                 @default("cart") // see order state machine
  subtotal           Decimal                @default(0)
  promoDiscount      Decimal                @default(0)
  vatAmount          Decimal                @default(0)
  shippingCost       Decimal                @default(0)
  total              Decimal                @default(0)
  currency           String                 @default("EUR")
  weightGrams        Int                    @default(0)
  packageCount       Int                    @default(1)
  deliveryName       String?
  deliveryEmail      String?
  deliveryPhone      String?
  deliveryAddress    String?
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryCountry    String?
  deliverySlot       String?
  carrierId          String?
  paymentMethod      String?
  fraudScore         Int                    @default(0)
  notes              String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]
  shipments          Shipment[]
  timeline           OrderEvent[]
  batchAllocations   OrderBatchAllocation[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  variantId       String?
  variantLabel    String?
  nameFr          String
  nameEn          String
  sku             String
  unitPrice       Decimal
  qty             Int
  lineTotal       Decimal
  thermalClass    String
  imageUrl        String?
  recipeId        String?
  recipeNameFr    String?
  recipeNameEn    String?
  packWeightGrams Int     @default(0)
  salesChannel    String  @default("retail") // retail | wholesale
  unitsPerPack    Int     @default(1)
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Media, advertising & administration team
 */
/**
 * -----------------------------------------------------------------
 */

model MediaAsset {
  id         String   @id @default(cuid())
  kind       String // product | recipe | advertisement | brand
  ownerType  String?
  ownerId    String?
  fileName   String
  objectPath String   @unique
  publicUrl  String
  mimeType   String
  sizeBytes  Int
  altFr      String?
  altEn      String?
  status     String   @default("active") // active | archived
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([kind, status])
  @@index([ownerType, ownerId])
}

model Advertisement {
  id         String    @id @default(cuid())
  placement  String    @default("home") // home | catalog | recipes | checkout
  titleFr    String
  titleEn    String
  bodyFr     String?
  bodyEn     String?
  imageUrl   String
  imageAltFr String
  imageAltEn String
  linkUrl    String    @default("/")
  status     String    @default("draft") // draft | published | archived
  priority   Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([placement, status, priority])
}

model AdminMembership {
  id          String    @id @default(cuid())
  authUserId  String?   @unique
  email       String    @unique
  firstName   String?
  lastName    String?
  role        String
  permissions String    @default("{}") // per-user JSON overrides
  status      String    @default("invited") // invited | active | suspended
  invitedBy   String
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role, status])
}

model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  String
  label   String
  at      DateTime @default(now())
  actor   String?
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Decimal
  method         String // card | apple_pay | google_pay | paypal | gift_card | store_credit
  status         String   @default("pending") // pending | authorized | captured | failed | refunded
  reference      String // idempotency / processor reference
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal
  reason    String
  status    String   @default("pending") // pending | completed | rejected
  createdAt DateTime @default(now())
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrierId         String?
  carrier           Carrier?  @relation(fields: [carrierId], references: [id])
  trackingNumber    String?
  thermalClass      String // AMBIANT | REFRIGERATED | FROZEN
  status            String    @default("created") // created | picked_up | in_transit | out_for_delivery | delivered | failed | lost
  proofPhoto        String?
  signature         String?
  confirmCode       String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  createdAt         DateTime  @default(now())
}

model Carrier {
  id          String         @id @default(cuid())
  name        String
  logo        String?
  trackingUrl String?
  rating      Int            @default(4)
  shipments   Shipment[]
  zones       DeliveryZone[]
}

model DeliveryZone {
  id              String   @id @default(cuid())
  carrierId       String?
  carrier         Carrier? @relation(fields: [carrierId], references: [id])
  country         String
  postalPattern   String?
  baseFee         Decimal  @default(4.9)
  perKgFee        Decimal  @default(0.6)
  frozenSurcharge Decimal  @default(2.5)
  minDelayHours   Int      @default(48)
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Marketing & support
 */
/**
 * -----------------------------------------------------------------
 */

model Promotion {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // percent | fixed | free_shipping
  value      Decimal
  minOrder   Decimal   @default(0)
  appliesTo  String    @default("all") // all | category | product | country
  targetId   String?
  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Decimal
  balance   Decimal
  currency  String    @default("EUR")
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model SupportTicket {
  id         String    @id @default(cuid())
  number     String    @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  orderId    String?
  subject    String
  priority   String    @default("normal") // low | normal | high | urgent
  status     String    @default("open") // open | pending | resolved | closed
  assignee   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/**
 * -----------------------------------------------------------------
 */
/**
 * Audit & notifications
 */
/**
 * -----------------------------------------------------------------
 */

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // price_change | stock_change | order_cancel | refund | product_delete | recipe_change | permission_change | batch_change
  entityType String
  entityId   String
  before     String? // JSON
  after      String? // JSON
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())
}

model Notification {
  id             String   @id @default(cuid())
  userId         String?
  channel        String // email | sms | web | push | whatsapp
  type           String
  titleFr        String
  titleEn        String
  bodyFr         String
  bodyEn         String
  url            String   @default("/")
  audience       String   @default("all")
  recipientCount Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  sent           Boolean  @default(false)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model PushSubscription {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  endpoint     String    @unique
  p256dh       String
  auth         String
  deviceId     String?
  locale       String    @default("fr")
  userAgent    String?
  enabled      Boolean   @default(true)
  failureCount Int       @default(0)
  lastSeenAt   DateTime  @default(now())
  lastSentAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deviceId])
  @@index([userId, enabled])
  @@index([enabled])
}
